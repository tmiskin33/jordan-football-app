# Copy to .env and fill in. Never commit the real .env — it is gitignored.

# Postgres connection string (Neon, Supabase, local Postgres, etc.)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth.js session secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Cloudflare R2 (film storage). From the R2 dashboard:
#   Account ID    — the id in the dashboard URL
#   Access keys   — R2 > Manage API Tokens > Create (Object Read & Write)
#   Public base   — the bucket's Settings > Public Access r2.dev URL
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_BASE_URL=""
